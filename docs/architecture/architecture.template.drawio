        <mxCell id="pe-e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8d6e28;strokeWidth=2;endArrow=block;endFill=1;" edge="1" parent="pe-g1" source="pe-ev-scene-content" target="pe-pl-scene-content">
