        <mxCell id="k8-i-tts" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=job;" vertex="1" parent="k8-n-texttospeech-manager">
          <mxGeometry x="10" y="30" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k8-t-tts" value="&lt;b&gt;texttospeech-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;KEDA &lt;b&gt;ScaledJob&lt;/b&gt;, not a Deployment&lt;br&gt;scales to zero · one pod per message&lt;br&gt;Quarkus native — milliseconds to start&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="k8-n-texttospeech-manager">
          <mxGeometry x="68" y="8" width="184" height="94" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-keda" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f3edf7;strokeColor=#9673a6;verticalAlign=top;" vertex="1" parent="k8-cluster">
          <mxGeometry x="960" y="560" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k8-t-keda" value="&lt;b&gt;KEDA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;reads queue depth from RabbitMQ directly&lt;br&gt;and starts a Job per message&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;spacingLeft=10;" vertex="1" parent="k8-n-keda">
          <mxGeometry x="0" y="8" width="252" height="74" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-hpa" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#78909c;verticalAlign=top;" vertex="1" parent="k8-cluster">
          <mxGeometry x="960" y="680" width="260" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k8-i-hpa" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=hpa;" vertex="1" parent="k8-n-hpa">
          <mxGeometry x="10" y="20" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="k8-t-hpa" value="&lt;b&gt;HorizontalPodAutoscaler&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;only the deployments whose handlers commute&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="k8-n-hpa">
          <mxGeometry x="68" y="8" width="184" height="74" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-statefulsets" value="" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;verticalAlign=top;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="540" width="260" height="220" as="geometry" />
        </mxCell>
        <mxCell id="k8-i-sts" value="" style="sketch=0;html=1;dashed=0;whiteSpace=wrap;fillColor=#2875E2;strokeColor=none;shape=mxgraph.kubernetes.icon;prIcon=sts;" vertex="1" parent="k8-n-statefulsets">
          <mxGeometry x="10" y="14" width="44" height="44" as="geometry" />
        </mxCell>
        <mxCell id="k8-t-sts" value="&lt;b&gt;StatefulSets&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;one per owner, PersistentVolumeClaim each:&lt;br&gt;account-vault · story-content-vault&lt;br&gt;scene-read-model (MongoDB) · character-vault&lt;br&gt;storypath-vault · recap-vault · minio&lt;br&gt;&lt;br&gt;No service reads another's volume. Tab 1 says which owns what.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;spacingTop=6;" vertex="1" parent="k8-n-statefulsets">
          <mxGeometry x="62" y="8" width="190" height="200" as="geometry" />
        </mxCell>

        <mxCell id="k8-obs" value="Observability — proposed, not chosen" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#fdf6e3;strokeColor=#d6a860;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=12;fontStyle=1;fontColor=#8d6e28;" vertex="1" parent="k8-cluster">
          <mxGeometry x="1260" y="60" width="400" height="560" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-promtail" value="&lt;b&gt;Promtail&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;DaemonSet · scrapes pod logs&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;fontSize=11;align=center;" vertex="1" parent="k8-obs">
          <mxGeometry x="20" y="50" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-loki" value="&lt;b&gt;Loki&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;log store&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;fontSize=11;align=center;" vertex="1" parent="k8-obs">
          <mxGeometry x="210" y="50" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-rabbitmq-exporter" value="&lt;b&gt;RabbitMQ Exporter&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;queue depth as metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;fontSize=11;align=center;" vertex="1" parent="k8-obs">
          <mxGeometry x="20" y="150" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-prometheus" value="&lt;b&gt;Prometheus&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;scrapes Actuator + exporter&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;fontSize=11;align=center;" vertex="1" parent="k8-obs">
          <mxGeometry x="210" y="150" width="170" height="70" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-grafana" value="&lt;b&gt;Grafana&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;one query surface over logs and metrics&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;fontSize=11;align=center;" vertex="1" parent="k8-obs">
          <mxGeometry x="115" y="260" width="170" height="90" as="geometry" />
        </mxCell>
        <mxCell id="k8-obs-note" value="&lt;b&gt;Why this shape&lt;/b&gt;&lt;br&gt;What matters is correlation: an id that survives from an HTTP request, through the broker, into a consumer. Per-service logs that cannot be joined are of little use when one player action touches four services.&lt;br&gt;&lt;br&gt;None of this is decided (OPEN-DESIGN-ISSUES 2.5). It is drawn so the group has something concrete to agree or reject." style="text;html=1;align=left;verticalAlign=top;fontSize=10;strokeColor=none;fillColor=#fffdf5;whiteSpace=wrap;spacingLeft=8;spacingTop=6;" vertex="1" parent="k8-obs">
          <mxGeometry x="20" y="380" width="360" height="165" as="geometry" />
        </mxCell>

        <mxCell id="k8-note-open-keda" value="&lt;b&gt;Open — how KEDA gets its metric&lt;/b&gt;&lt;br&gt;Drawn reading RabbitMQ directly, which is KEDA's own scaler and needs nothing else. The alternative is RabbitMQ Exporter → Prometheus → KEDA, which is worth it only if the scaling decision needs a derived metric rather than a queue length.&lt;br&gt;&lt;br&gt;Also open: nothing here is built, so the claim that a Quarkus native binary makes scale-to-zero worth having is still a claim, not a measurement." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="k8-cluster">
          <mxGeometry x="640" y="600" width="280" height="300" as="geometry" />
        </mxCell>
        <mxCell id="k8-note-images" value="&lt;b&gt;Open — how images reach the cluster&lt;/b&gt;&lt;br&gt;kind load docker-image is simplest and needs no registry, but it is a manual step that cannot appear in a pipeline. A local registry is one more component to run, and is what the CD pipeline will have to push to anyway. Drawn as a registry; the group has not decided." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="800" width="560" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k8-note-autoscale" value="&lt;b&gt;Probes, configuration and scaling&lt;/b&gt;&lt;br&gt;Liveness asks whether the process is alive, and a failure restarts the pod. Readiness asks whether it can serve, and a failure only removes it from the Service. A service that cannot reach RabbitMQ is not broken and must not be restarted — so readiness reflects broker connectivity and liveness does not.&lt;br&gt;&lt;br&gt;Every host, port and credential comes from the environment with a local default, so the same image runs in compose and here. Graceful shutdown is longer than one message, so a redeploy does not abandon work. Consumers scale on queue depth; query-serving services scale on request rate or CPU — not one metric." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="1000" width="560" height="160" as="geometry" />
        </mxCell>

        <mxCell id="k8-e-player" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="k8-client-player" target="k8-n-ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-author" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="k8-client-author" target="k8-n-ingress">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-ing-scene" value="routes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-ingress" target="k8-n-scene-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-ing-account" value="routes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-ingress" target="k8-n-account-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-scene-broker" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=9;fontColor=#b07d00;" edge="1" parent="k8-cluster" source="k8-n-scene-manager" target="k8-n-rabbitmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-storycontent-broker" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=9;fontColor=#b07d00;" edge="1" parent="k8-cluster" source="k8-n-storycontent-manager" target="k8-n-rabbitmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-broker-character" value="consumes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=9;fontColor=#b07d00;" edge="1" parent="k8-cluster" source="k8-n-rabbitmq" target="k8-n-character-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-broker-storypath" value="consumes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=9;fontColor=#b07d00;" edge="1" parent="k8-cluster" source="k8-n-rabbitmq" target="k8-n-storypath-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-recap-storypath" value="gRPC :9091" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontColor=#6c5ce7;" edge="1" parent="k8-cluster" source="k8-n-recap-manager" target="k8-n-storypath-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-keda-broker" value="polls queue depth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-keda" target="k8-n-rabbitmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-keda-tts" value="starts a Job per message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-keda" target="k8-n-texttospeech-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-hpa-character" value="scales" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#78909c;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-hpa" target="k8-n-character-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-promtail-loki" value="sends logs" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-obs" source="k8-n-promtail" target="k8-n-loki">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-exporter-prom" value="exposes metrics" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-obs" source="k8-n-rabbitmq-exporter" target="k8-n-prometheus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-loki-grafana" value="queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-obs" source="k8-n-grafana" target="k8-n-loki">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-prom-grafana" value="queries" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-obs" source="k8-n-grafana" target="k8-n-prometheus">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e-promtail-pods" value="scrapes logs from every pod" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=1;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-promtail" target="k8-n-recap-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Contracts and versions" id="contracts">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ct-title" value="Contracts and versions" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ct-sub" value="Generated in full from architecture.json. This is the tab the report's per-service section is written from, and the one to change when a service ships: edit the manifest, run the build, and every tab is correct again." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ct-stamp-label" value="manifest last updated" style="text;html=1;fontSize=11;fontColor=#90a4ae;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="4" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ct-stamp" value="{{meta:updated}}" style="text;html=1;fontSize=11;fontColor=#90a4ae;align=left;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="230" y="4" width="200" height="22" as="geometry" />
        </mxCell>

        <mxCell id="ct-table" value="{{table:contracts}}" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="1900" height="760" as="geometry" />
        </mxCell>

        <mxCell id="ct-key" value="&lt;b&gt;Reading this table&lt;/b&gt;&lt;br&gt;✓ marks a contract file the group believes is written; ⚠ marks one that is still a gap. The verifier compares both against the filesystem and reports a mismatch, so a ✓ that is not really there shows up in CI rather than in the report.&lt;br&gt;&lt;br&gt;A dash means the service has nothing of that kind yet — not that it never will." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="620" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ct-gaps" value="&lt;b&gt;The honest summary&lt;/b&gt;&lt;br&gt;One AsyncAPI document exists, out of four publishers. No OpenAPI document exists at all. The one .proto that exists sits in the caller's source tree rather than with the service that implements it.&lt;br&gt;&lt;br&gt;That is the state of the contracts, and the diagram says so rather than drawing a system that is further along than it is." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="840" width="620" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Rejected alternative — separate indexer" id="alt-indexer">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="alt-title" value="Rejected alternative — the projection as its own service" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="alt-sub" value="Kept so the choice can be compared rather than asserted. The question is not how many services there are; it is who owns the read model." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="alt-rejected" value="REJECTED — SceneIndexer as a service of its own" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#962d22;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="620" height="520" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-indexer" value="&lt;b&gt;SceneIndexer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;consumes scene-content.updated&lt;br&gt;writes only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="alt-rejected">
          <mxGeometry x="30" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-manager" value="&lt;b&gt;SceneManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;serves scenes, validates choices&lt;br&gt;reads only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="alt-rejected">
          <mxGeometry x="320" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-store" value="&lt;b&gt;scene read model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;MongoDB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="alt-rejected">
          <mxGeometry x="175" y="250" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-warn" value="⚠ Two services share one datastore. Neither can change the document format without asking the other, so they are one unit of deployment in two repositories — exactly the coupling the decomposition exists to remove." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#962d22;" vertex="1" parent="alt-rejected">
          <mxGeometry x="30" y="390" width="540" height="100" as="geometry" />
        </mxCell>

        <mxCell id="alt-chosen" value="CHOSEN — one service, two deployments" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#e8f5e9;strokeColor=#66a06a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3f7043;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="620" height="520" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-service" value="SceneManager — one service, one schema, one release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;" vertex="1" parent="alt-chosen">
          <mxGeometry x="30" y="60" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-api" value="&lt;b&gt;query serving&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service&lt;br&gt;scales on request rate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="alt-c-service">
          <mxGeometry x="10" y="50" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-indexer" value="&lt;b&gt;scene-indexer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment, no Service&lt;br&gt;same image, restarts without taking queries down&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="alt-c-service">
          <mxGeometry x="280" y="50" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-store" value="&lt;b&gt;scene read model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;MongoDB — owned by SceneManager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="alt-chosen">
          <mxGeometry x="175" y="300" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-note" value="One owner. The projector can be scaled and restarted on its own, and the schema still has exactly one service answering for it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#3f7043;" vertex="1" parent="alt-chosen">
          <mxGeometry x="30" y="430" width="540" height="70" as="geometry" />
        </mxCell>

        <mxCell id="alt-e1" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="alt-rejected" source="alt-r-indexer" target="alt-r-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="alt-e2" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="alt-rejected" source="alt-r-manager" target="alt-r-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="alt-e3" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#66a06a;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="alt-chosen" source="alt-c-service" target="alt-c-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="alt-n1" value="&lt;b&gt;The test that decides it&lt;/b&gt;&lt;br&gt;Can the indexer change the document format without asking SceneManager? If yes, they are two services and must not share a store. If no — and here the answer is no, because the shape of a read model is decided by the queries it answers — then they are one service that happens to run as two processes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="alt-n2" value="&lt;b&gt;Ownership follows the schema&lt;/b&gt;&lt;br&gt;A change always starts as &quot;the API needs this field&quot;. The projector is then updated to comply; it never requests a schema change of its own. Calling the indexer the owner while SceneManager only reads would put two services on one data model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="620" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="alt-n3" value="&lt;b&gt;When a separate indexer is right&lt;/b&gt;&lt;br&gt;When the index is shared infrastructure that several services query — a search cluster, say — rather than one service's own read model. Then it has its own consumers, its own reasons to change, and no single service answering for its schema.&lt;br&gt;&lt;br&gt;That is not this." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="620" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="alt-n4" value="&lt;b&gt;The principle&lt;/b&gt;&lt;br&gt;The goal is not the largest number of separations, but high cohesion and low coupling. Splitting a thing that changes together buys an extra deployment and pays for it with a shared database — which is the coupling the whole decomposition exists to remove.&lt;br&gt;&lt;br&gt;&lt;i&gt;Two deployments sharing a datastore is acceptable only because they are versioned and released together, and one person owns both.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="620" width="320" height="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

