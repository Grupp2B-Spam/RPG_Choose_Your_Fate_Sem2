  <diagram name="Flow — player makes a choice" id="flow-choice">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fc-title" value="Flow — player makes a choice" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fc-sub" value="The choice is validated where the content lives. Two consumers take the event independently — there is no saga here." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="fc-l1" value="Player client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l2" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l3" value="SceneManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l4" value="RabbitMQ&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;scenemanager.events&lt;br&gt;player-choice.made&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#d79b00;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l5" value="CharacterManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l6" value="StoryPathManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="80" width="200" height="820" as="geometry" />
        </mxCell>

        <mxCell id="fc-a1" value="3. validates against the read model: does this choice exist in this scene?&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;it does not check that the character is standing there — see OPEN-DESIGN-ISSUES 3.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6a860;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fc-l3">
          <mxGeometry x="10" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fc-a2" value="7a. applies the effects&lt;br&gt;−10 HP, +1 sword&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;deltas commute, so this consumer scales&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fc-l5">
          <mxGeometry x="10" y="560" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fc-a3" value="7b. appends the beat at its sequence number&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;an ordered log: one consumer instance until the sequence number has an owner&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fc-l6">
          <mxGeometry x="10" y="640" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="fc-m1" value="1. POST /characters/{characterId}/choices&lt;br&gt;{ sceneId, choiceId }  ·  Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.073;exitDx=0;exitDy=0;entryX=0;entryY=0.073;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l1" target="fc-l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m2" value="2. forwarded — token verified locally" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.146;exitDx=0;exitDy=0;entryX=0;entryY=0.146;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l2" target="fc-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m3" value="4. publishes { eventId, characterId, sequence,&lt;br&gt;sceneId, sceneVersion, choiceId, beat, effects }" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.366;exitDx=0;exitDy=0;entryX=0;entryY=0.366;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l3" target="fc-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m4" value="5. next scene — returned immediately,&lt;br&gt;without waiting for either consumer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.49;exitDx=0;exitDy=0;entryX=1;entryY=0.49;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l3" target="fc-l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m5" value="6. one event, two queues — delivered to both" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.61;exitDx=0;exitDy=0;entryX=0;entryY=0.61;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l4" target="fc-l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m6" value="6. charactermanager.player-choice&lt;br&gt;and storypathmanager.player-choice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.73;exitDx=0;exitDy=0;entryX=0;entryY=0.73;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l4" target="fc-l6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fc-n1" value="&lt;b&gt;Why there is no saga&lt;/b&gt;&lt;br&gt;7a and 7b are independent. The beat landing half a second after the stat change is not an inconsistency anyone can observe, because nothing reads them together before the next choice. A saga would add a coordinator to protect an invariant that does not exist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="120" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fc-n2" value="&lt;b&gt;What the queue has to guarantee&lt;/b&gt;&lt;br&gt;Delivery is at-least-once, so both consumers deduplicate on eventId. Order matters only for the path, and it is carried in the data: every entry has a per-character sequence number, so entries can arrive in any order and still be read in sequence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="350" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fc-n3" value="&lt;b&gt;Open — who assigns the sequence number&lt;/b&gt;&lt;br&gt;Who assigns the sequence number? If StoryPathManager assigns it on insert, ordering still depends on arrival order and nothing is gained — the number has to be assigned by the publisher. But that means SceneManager would need to know the character's current position, which today lives in StoryPathManager.&lt;br&gt;&lt;br&gt;Until this is settled, StoryPathManager runs as a single consumer instance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="580" width="320" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Flow — recap with narration" id="flow-recap">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fr-title" value="Flow — recap with narration" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fr-sub" value="The path is fetched over gRPC from a stored checkpoint, so a recap is rebuilt from a snapshot plus what is new — not from the whole history every time." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="fr-l1" value="Player client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l2" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l3" value="RecapManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l4" value="StoryPathManager&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;gRPC :9091&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l5" value="TextToSpeechManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3edf7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l6" value="ElevenLabs&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;external · paid per call&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="80" width="200" height="980" as="geometry" />
        </mxCell>

        <mxCell id="fr-a1" value="3. reads its checkpoint for this character&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;the sequence number of the last beat already in the recap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l3">
          <mxGeometry x="10" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fr-a2" value="7. generates the recap with the LLM and stores it&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;the checkpoint advances to snapshotSequence — the snapshot pattern&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l3">
          <mxGeometry x="10" y="480" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fr-a3" value="9. hash = sha256(text + voice)&lt;br&gt;looks in its own store first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l5">
          <mxGeometry x="10" y="620" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fr-a4" value="12. stores the file in MinIO under the hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l5">
          <mxGeometry x="10" y="820" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="fr-m1" value="1. GET /characters/{characterId}/recaps/latest?audio=true&lt;br&gt;Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.061;exitDx=0;exitDy=0;entryX=0;entryY=0.061;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l1" target="fr-l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m2" value="2. forwarded — token verified locally" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.122;exitDx=0;exitDy=0;entryX=0;entryY=0.122;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l2" target="fr-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m3" value="4. gRPC GetChoicesAfter(characterId,&lt;br&gt;afterSequence, pageSize, snapshotSequence=0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6c5ce7;exitX=1;exitY=0.265;exitDx=0;exitDy=0;entryX=0;entryY=0.265;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m4" value="5. entries after the checkpoint, strictly ascending,&lt;br&gt;plus snapshotSequence and hasMore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6c5ce7;exitX=0;exitY=0.337;exitDx=0;exitDy=0;entryX=1;entryY=0.337;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l4" target="fr-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m5" value="6. pages until hasMore is false, echoing snapshotSequence&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;so every page comes from the same high-water mark&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#6c5ce7;exitX=1;exitY=0.408;exitDx=0;exitDy=0;entryX=0;entryY=0.408;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m6" value="8. publishes recap-generated&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;planned — RecapManager does not publish it yet&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.592;exitDx=0;exitDy=0;entryX=0;entryY=0.592;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m7" value="10. on cache miss only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.735;exitDx=0;exitDy=0;entryX=0;entryY=0.735;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l5" target="fr-l6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m8" value="11. audio file" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.786;exitDx=0;exitDy=0;entryX=1;entryY=0.786;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l6" target="fr-l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m9" value="13. { recapText, audioUrl }" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.918;exitDx=0;exitDy=0;entryX=1;entryY=0.918;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fr-n1" value="&lt;b&gt;Why gRPC and not REST&lt;/b&gt;&lt;br&gt;RecapManager needs the path to answer a request already in flight, so the call is synchronous. The defensible argument is the enforced contract, not speed: story_path.proto is compiled into both sides, so calling a method that does not exist fails the build rather than the request." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="120" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="fr-n2" value="&lt;b&gt;Cache hit&lt;/b&gt;&lt;br&gt;Steps 10 to 12 are skipped entirely. The answer is immediate and costs nothing at ElevenLabs, because the same text and voice always hash to the same file and the store never overwrites." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="370" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fr-n3" value="&lt;b&gt;The checkpoint is the snapshot pattern&lt;/b&gt;&lt;br&gt;A recap is rebuilt from a stored checkpoint plus the entries since, rather than by re-reading the whole history. Using snapshotSequence as a high-water mark means a beat appended mid-paging does not land halfway through the recap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="570" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fr-n4" value="&lt;b&gt;Dashed lifelines are not built yet&lt;/b&gt;&lt;br&gt;StoryPathManager's gRPC server, the recap-generated event and TextToSpeechManager are all planned. Only steps 1, 2, 3 and 7 run today, against a mock path source." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="800" width="320" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Development environment — docker compose" id="env-compose">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dc-title" value="Development environment — docker compose" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dc-sub" value="Current state: what docker compose starts today, on main. Each service owns a compose file next to its code, and the root file merges them with include:, so everything shares one network and each person edits only their own file." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="dc-project" value="docker compose project — one network" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#f7f9fa;strokeColor=#90a4ae;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#546e7a;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1240" height="620" as="geometry" />
        </mxCell>

        <mxCell id="dc-root" value="&lt;b&gt;docker-compose.yml&lt;/b&gt; (root)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;include:&lt;br&gt;· microservices/storycontent-manager/compose.yaml&lt;br&gt;· microservices/recapManager/docker-compose-recap-manager.yml&lt;br&gt;&lt;br&gt;volumes: rabbitmq-data&lt;br&gt;&lt;br&gt;Relative paths inside an included file resolve against that file's own directory, so each service still runs on its own.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-project">
          <mxGeometry x="30" y="50" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dc-rabbit" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#d79b00;verticalAlign=top;" vertex="1" parent="dc-project">
          <mxGeometry x="420" y="50" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dc-rabbit-infra" value="{{infra:rabbitmq:label}}" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="dc-rabbit">
          <mxGeometry x="0" y="0" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dc-rabbit-compose" value="&lt;font style=&quot;font-size: 10px&quot;&gt;hostname: rabbitmq&lt;br&gt;volume: rabbitmq-data&lt;br&gt;healthcheck: rabbitmq-diagnostics ping&lt;br&gt;restart: unless-stopped&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=none;fillColor=#fffaf2;whiteSpace=wrap;" vertex="1" parent="dc-rabbit">
          <mxGeometry x="0" y="110" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dc-frontend" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;profiles: [prod]&lt;br&gt;build: ./choose-your-fate-frontend&lt;br&gt;VITE_API_URL: http://localhost:8080/&lt;br&gt;ports: 5173 → 80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-project">
          <mxGeometry x="830" y="50" width="380" height="190" as="geometry" />
        </mxCell>

        <mxCell id="dc-inc-recap" value="included — microservices/recapManager/" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=2;fontColor=#3f7043;" vertex="1" parent="dc-project">
          <mxGeometry x="30" y="270" width="570" height="310" as="geometry" />
        </mxCell>
        <mxCell id="dc-recap-manager" value="&lt;b&gt;recap-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;profiles: [prod]&lt;br&gt;build: .&lt;br&gt;ports: 8090 → 8090&lt;br&gt;MYSQL_URI: recap-vault:3306&lt;br&gt;STORYPATH_GRPC_TARGET: storypath-manager:9091&lt;br&gt;JWT public key: read-only bind mount&lt;br&gt;depends_on: recap-vault (service_healthy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-recap">
          <mxGeometry x="20" y="50" width="250" height="230" as="geometry" />
        </mxCell>
        <mxCell id="dc-recap-vault" value="&lt;b&gt;recap-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;image: mysql:9.5.0&lt;br&gt;ports: 3307 → 3306&lt;br&gt;volume: recap-vault&lt;br&gt;init: 01_schema_recap_vault.sql&lt;br&gt;healthcheck: mysqladmin ping&lt;br&gt;&lt;br&gt;Seeding runs only on the first start, when the volume is created.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-recap">
          <mxGeometry x="300" y="50" width="250" height="230" as="geometry" />
        </mxCell>

        <mxCell id="dc-inc-storycontent" value="included — microservices/storycontent-manager/" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#fff8e1;strokeColor=#d6a860;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=2;fontColor=#8d6e28;" vertex="1" parent="dc-project">
          <mxGeometry x="630" y="270" width="580" height="310" as="geometry" />
        </mxCell>
        <mxCell id="dc-storycontent-manager" value="&lt;b&gt;storycontent-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;profiles: [prod]&lt;br&gt;build: .&lt;br&gt;ports: 8081 → 8081&lt;br&gt;RABBITMQ_HOST: rabbitmq&lt;br&gt;MYSQL_URI: story-content-vault:3306/story_content&lt;br&gt;depends_on: story-content-vault, rabbitmq&lt;br&gt;(both service_healthy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-storycontent">
          <mxGeometry x="20" y="50" width="250" height="230" as="geometry" />
        </mxCell>
        <mxCell id="dc-storycontent-vault" value="&lt;b&gt;story-content-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;image: mysql:9.5.0&lt;br&gt;ports: 3309 → 3306&lt;br&gt;MYSQL_DATABASE: story_content&lt;br&gt;volume: story-content-vault&lt;br&gt;init: ./db-init&lt;br&gt;healthcheck: mysqladmin ping&lt;br&gt;&lt;br&gt;3307 and 3308 are taken by the monolith's databases.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-storycontent">
          <mxGeometry x="300" y="50" width="260" height="230" as="geometry" />
        </mxCell>

        <mxCell id="dc-e1" value="depends_on · service_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="dc-inc-recap" source="dc-recap-manager" target="dc-recap-vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dc-e2" value="depends_on · service_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="dc-inc-storycontent" source="dc-storycontent-manager" target="dc-storycontent-vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dc-e3" value="depends_on · publishes to storycontent.events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=9;fontColor=#b07d00;" edge="1" parent="dc-project" source="dc-storycontent-manager" target="dc-rabbit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="dc-n1" value="&lt;b&gt;What a bare `docker compose up` starts&lt;/b&gt;&lt;br&gt;Only rabbitmq and the two databases. The services and the frontend carry profiles: [prod], so they stay down unless you ask for them — which is what you want while running a service from the IDE against the containers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="60" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dc-n2" value="&lt;b&gt;What is not here yet&lt;/b&gt;&lt;br&gt;AccountManager, SceneManager, CharacterManager, StoryPathManager and TextToSpeechManager have no compose file, and neither does MinIO. Ollama runs on the host at localhost:11434 rather than in the project, so a recap can be generated without a GPU container in the compose file.&lt;br&gt;&lt;br&gt;The monolith is not started by any compose file either." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="270" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="dc-n3" value="&lt;b&gt;How much of the system this is&lt;/b&gt;&lt;br&gt;Two of the seven services. What this environment exercises is the broker, two databases and one publisher — not the architecture on tab 1.&lt;br&gt;&lt;br&gt;That is worth knowing before reading a green `docker compose up` as evidence that the system works. The system-level cooperation test the exam asks for needs a choice flowing from SceneManager through the broker into two consumers, and none of those three exist here yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="540" width="340" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

