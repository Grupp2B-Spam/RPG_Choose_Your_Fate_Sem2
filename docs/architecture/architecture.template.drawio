        <mxCell id="pe-g4" value="account.events" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#eceff1;strokeColor=#90a4ae;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#546e7a;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="2000" y="140" width="380" height="830" as="geometry" />
        </mxCell>
