  <diagram name="Broker topology" id="broker-topology">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="bt-title" value="Broker topology" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-130" width="1400" height="40" as="geometry" />
        </mxCell>
        <mxCell id="bt-sub" value="Exchanges, the routing key on each binding, the queue each one feeds and who drains it — and where a message goes when a consumer rejects it. Solid is declared and verified against a running broker; dashed does not exist yet." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-85" width="1800" height="24" as="geometry" />
        </mxCell>

        <mxCell id="bt-pub-storycontent" value="&lt;b&gt;StoryContentManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;declares the exchange, the three consumer queues, their bindings and the whole dead-letter path&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="180" width="280" height="120" as="geometry" />
        </mxCell>
        <mxCell id="bt-pub-scenemanager" value="&lt;b&gt;SceneManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;not written yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="540" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bt-pub-recap" value="&lt;b&gt;RecapManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;running, but does not publish yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="760" width="280" height="90" as="geometry" />
        </mxCell>
        <mxCell id="bt-pub-account" value="&lt;b&gt;AccountManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;not written yet&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="40" y="900" width="280" height="90" as="geometry" />
        </mxCell>

        <mxCell id="bt-broker" value="RabbitMQ — choose-your-fate-rabbitmq" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#fff9f0;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#b07d00;arcSize=3;" vertex="1" parent="1">
          <mxGeometry x="360" y="120" width="1560" height="1080" as="geometry" />
        </mxCell>

        <mxCell id="bt-ex-storycontent" value="&lt;b&gt;storycontent.events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;topic · durable&lt;br&gt;&lt;br&gt;scene-content.updated&lt;br&gt;item-definition.updated&lt;br&gt;race-definition.updated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="bt-broker">
          <mxGeometry x="60" y="60" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="bt-q-scene-content" value="&lt;b&gt;scenemanager.scene-content&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;drained by SceneManager · durable, not auto-delete, not exclusive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="500" y="60" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-q-item-rules" value="&lt;b&gt;charactermanager.item-rules&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;drained by CharacterManager · durable, not auto-delete, not exclusive&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="500" y="160" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-q-race-definitions" value="&lt;b&gt;charactermanager.race-definitions&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;drained by CharacterManager · renamed from race-cache: the publisher owns the queue now, so naming it after what the consumer does with the data would be wrong&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="500" y="260" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="bt-dlq-scene-content" value="scenemanager.scene-content.dlq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="1020" y="60" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-dlq-item-rules" value="charactermanager.item-rules.dlq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="1020" y="160" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-dlq-race-definitions" value="charactermanager.race-definitions.dlq" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;align=center;verticalAlign=middle;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="1020" y="260" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="bt-ex-scenemanager" value="&lt;b&gt;scenemanager.events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;topic · planned&lt;br&gt;player-choice.made&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="bt-broker">
          <mxGeometry x="60" y="400" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bt-q-storypath-pc" value="&lt;b&gt;storypathmanager.player-choice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;drained by StoryPathManager · one instance only, because the path is an ordered log&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="500" y="400" width="440" height="80" as="geometry" />
        </mxCell>
        <mxCell id="bt-q-character-pc" value="&lt;b&gt;charactermanager.player-choice&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;drained by CharacterManager · effects are deltas, so several instances are safe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="500" y="500" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bt-ex-recap" value="&lt;b&gt;recap.events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;topic · planned&lt;br&gt;recap-generated&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="bt-broker">
          <mxGeometry x="60" y="620" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bt-q-tts-recap" value="&lt;b&gt;texttospeechmanager.recap&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;drained by TextToSpeechManager · keyed on a content hash, so several instances are safe&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="500" y="620" width="440" height="80" as="geometry" />
        </mxCell>

        <mxCell id="bt-ex-account" value="&lt;b&gt;account.events&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;topic · planned&lt;br&gt;account-deletion-requested&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="bt-broker">
          <mxGeometry x="60" y="760" width="340" height="100" as="geometry" />
        </mxCell>
        <mxCell id="bt-q-account-del" value="&lt;b&gt;charactermanager.account-deletion&lt;br&gt;storypathmanager.account-deletion&lt;br&gt;recapmanager.account-deletion&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;one queue per service holding player state — the saga&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="500" y="760" width="440" height="100" as="geometry" />
        </mxCell>

        <mxCell id="bt-ex-dlx" value="&lt;b&gt;dlx&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;direct · durable&lt;br&gt;&lt;br&gt;Direct, because each queue dead-letters to its own exact name. A topic exchange would work too, but nothing here needs a pattern.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="bt-broker">
          <mxGeometry x="60" y="900" width="340" height="140" as="geometry" />
        </mxCell>
        <mxCell id="bt-dlq-note" value="&lt;b&gt;Nothing consumes the three .dlq queues&lt;/b&gt;&lt;br&gt;They exist so a rejected message is somewhere a person can look, rather than redelivered forever or dropped.&lt;br&gt;&lt;br&gt;Declaring dlx on its own would not have made dead-lettering work: RabbitMQ does not check x-dead-letter-exchange when a queue is declared, and an exchange with nothing bound to it discards what it receives. The queues are what make the path real.&lt;br&gt;&lt;br&gt;Retry counts and backoff are still undecided." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fffdf5;strokeColor=#c0392b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="bt-broker">
          <mxGeometry x="1020" y="400" width="440" height="280" as="geometry" />
        </mxCell>

        <mxCell id="bt-note-interim" value="&lt;b&gt;The publisher declares its consumers' queues — for now&lt;/b&gt;&lt;br&gt;A topic exchange stores nothing. Until a consumer has started once, its queue does not exist, and every event published in that window is discarded while the publish call still returns success. Nobody gets an error on either side.&lt;br&gt;&lt;br&gt;So StoryContentManager declares the queues and bindings too. That is interim, and it costs something: a consumer can no longer choose its own queue arguments, and one that redeclares a queue differently gets PRECONDITION_FAILED and will not start.&lt;br&gt;&lt;br&gt;The way back: each queue definition stays in its consumer's repository and is applied at deploy time, whether or not that consumer has ever run." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="180" width="420" height="420" as="geometry" />
        </mxCell>
        <mxCell id="bt-note-pubsub" value="&lt;b&gt;Publish-subscribe here is several queues, not a shared one&lt;/b&gt;&lt;br&gt;A RabbitMQ queue is point-to-point: whatever is in it goes to exactly one consumer. Two services reading the same event therefore need two queues bound to the same exchange and routing key — which is what player-choice.made does.&lt;br&gt;&lt;br&gt;Note also that one publisher feeds two different services from one exchange: SceneManager takes scene-content.updated, CharacterManager takes the item and race definitions. The publisher knows about none of them." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="630" width="420" height="340" as="geometry" />
        </mxCell>
        <mxCell id="bt-note-verified" value="&lt;b&gt;Read off a running broker&lt;/b&gt;&lt;br&gt;The solid half of this tab was checked against RabbitMQ 4.4.0 with the services started, not read out of the source. Every queue: durable, not auto-delete, not exclusive. The three consumer queues carry x-dead-letter-exchange: dlx and x-dead-letter-routing-key: &amp;lt;queue&amp;gt;.dlq.&lt;br&gt;&lt;br&gt;The dashed half is what the contracts describe and nobody has built." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1960" y="1000" width="420" height="280" as="geometry" />
        </mxCell>

        <mxCell id="bt-e-pub-sc" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#b07d00;" edge="1" parent="1" source="bt-pub-storycontent" target="bt-ex-storycontent">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-e-pub-sm" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="bt-pub-scenemanager" target="bt-ex-scenemanager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-e-pub-rc" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="bt-pub-recap" target="bt-ex-recap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-e-pub-ac" value="publishes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="bt-pub-account" target="bt-ex-account">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="bt-b1" value="scene-content.updated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#b07d00;" edge="1" parent="bt-broker" source="bt-ex-storycontent" target="bt-q-scene-content">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-b2" value="item-definition.updated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#b07d00;" edge="1" parent="bt-broker" source="bt-ex-storycontent" target="bt-q-item-rules">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-b3" value="race-definition.updated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#b07d00;" edge="1" parent="bt-broker" source="bt-ex-storycontent" target="bt-q-race-definitions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-b4" value="player-choice.made" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="bt-broker" source="bt-ex-scenemanager" target="bt-q-storypath-pc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-b5" value="player-choice.made" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="bt-broker" source="bt-ex-scenemanager" target="bt-q-character-pc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-b6" value="recap-generated" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="bt-broker" source="bt-ex-recap" target="bt-q-tts-recap">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-b7" value="account-deletion-requested" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="bt-broker" source="bt-ex-account" target="bt-q-account-del">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="bt-d1" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#962d22;" edge="1" parent="bt-broker" source="bt-q-scene-content" target="bt-dlq-scene-content">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-d2" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#962d22;" edge="1" parent="bt-broker" source="bt-q-item-rules" target="bt-dlq-item-rules">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-d3" value="rejected" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#962d22;" edge="1" parent="bt-broker" source="bt-q-race-definitions" target="bt-dlq-race-definitions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bt-d4" value="via dlx, routing key = the queue's own name" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#962d22;" edge="1" parent="bt-broker" source="bt-ex-dlx" target="bt-dlq-race-definitions">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
