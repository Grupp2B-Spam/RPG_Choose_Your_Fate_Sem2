          <mxGeometry x="0" y="0" width="640" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note-legacy" value="The only part of the system that runs today. The seven services are being lifted out of it; the pale arrows say which bounded context each part becomes. No compose file starts it, and no decommissioning date has been set." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=10;fontColor=#546e7a;strokeColor=none;fillColor=#f5f7f8;whiteSpace=wrap;" vertex="1" parent="panel-choose-your-fate-backend">
          <mxGeometry x="0" y="150" width="640" height="150" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1660" width="460" height="320" as="geometry" />
        </mxCell>
        <mxCell id="lg-async" value="— — —  asynchronous event (publish / consume)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#d79b00;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="40" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-grpc" value="————  internal gRPC call (never reaches the browser)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#6c5ce7;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="72" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-rest" value="————  external REST / GraphQL (client-facing)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#82b366;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="104" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-store" value="————  datastore ownership (not communication)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#90a4ae;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="136" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-status" value="● implemented   ◐ skeleton   ○ planned (dashed border)&lt;br&gt;A dashed box is a service that does not exist yet. A branch name under the badge means the code is written but not merged." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;fontColor=#546e7a;strokeColor=none;fillColor=#f5f7f8;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="10" y="172" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg-frame" value="Dashed frame = bounded context. Database symbol = a datastore owned by exactly one service. An event box inside RabbitMQ names its exchange and how many queues bind to it." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;fontColor=#546e7a;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="10" y="236" width="440" height="74" as="geometry" />
        </mxCell>

        <mxCell id="note-oauth" value="&lt;b&gt;Open — OAuth / OIDC&lt;/b&gt;&lt;br&gt;No third-party identity provider has been chosen. Required in addition to our own JWT, and it belongs in AccountManager." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="440" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-graphql" value="&lt;b&gt;Open — GraphQL owner&lt;/b&gt;&lt;br&gt;At least one service must expose GraphQL. SceneManager and CharacterManager are the candidates: both answer queries where a client wants many related fields in one round trip." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="620" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-adr013" value="&lt;b&gt;Open — who assigns the sequence number&lt;/b&gt;&lt;br&gt;Who assigns the per-character sequence number? If StoryPathManager assigns it on insert, ordering still depends on arrival order and nothing is gained — and until it is answered, StoryPathManager cannot be scaled horizontally." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="800" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="note-proto" value="&lt;b&gt;Open — who owns the gRPC contract&lt;/b&gt;&lt;br&gt;story_path.proto describes StoryPathManager's API but lives in RecapManager's source tree, so the server's owner can have their interface changed without touching their own code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1000" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-ports" value="&lt;b&gt;Open — port allocation&lt;/b&gt;&lt;br&gt;8081 and 8090 are taken, and 8092 is implied by RecapManager's JWT_ISSUER default without anyone having written it down. Services with no agreed port show none here rather than an invented one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1180" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note-keda" value="&lt;b&gt;Open — serverless&lt;/b&gt;&lt;br&gt;TextToSpeechManager is meant to run as a KEDA ScaledJob scaled on queue depth, which is why it is on Quarkus. Neither the job nor the cold-start measurement exists yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1460" width="340" height="160" as="geometry" />
        </mxCell>

        <mxCell id="note-versioning" value="&lt;b&gt;Open — two REST versioning styles&lt;/b&gt;&lt;br&gt;StoryContentManager puts the version in the path (/admin/v1/...). RecapManager reads an X-API-VERSION header. Both work, but the report has to describe one strategy, and a third service will otherwise pick a third way." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1660" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="e-c1-gw" value="HTTPS" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="1" source="c1" target="gw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
