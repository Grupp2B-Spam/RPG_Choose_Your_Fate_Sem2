        </mxCell>
        <mxCell id="k8-sub" value="The destination, not today. One name per service — Deployment, Service, image and Maven artifact all share it — because a Service name becomes the DNS name other services resolve." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="-85" width="1500" height="24" as="geometry" />
