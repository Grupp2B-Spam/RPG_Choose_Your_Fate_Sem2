        <mxCell id="pe-envelope" value="{{meta:envelope}}" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#546e7a;strokeWidth=2;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="60" y="1010" width="720" height="330" as="geometry" />
        </mxCell>

        <mxCell id="pe-note-reading" value="&lt;b&gt;How to read a payload box&lt;/b&gt;&lt;br&gt;Fields come from the manifest, and the verifier checks each one still appears in the contract file that describes the event — so a field renamed in the AsyncAPI document and not here shows up in CI rather than in the report.&lt;br&gt;&lt;br&gt;A dashed box is an event that does not exist yet. Where no payload has been designed, nothing is drawn: a plausible guess printed in this shape would be read as a contract by the next person who opens the file." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="820" y="1010" width="600" height="330" as="geometry" />
        </mxCell>
        <mxCell id="pe-note-state" value="&lt;b&gt;Where the contracts actually stand&lt;/b&gt;&lt;br&gt;One AsyncAPI document exists, covering the two StoryContentManager events. player-choice.made has a field list agreed in discussion but no contract file. recap-generated and account-deletion-requested have neither.&lt;br&gt;&lt;br&gt;The exam requires AsyncAPI documentation for every message-based flow — brokers, topics, schemas, producers, consumers. Three of five are missing, and this page is where that is visible at a glance." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1440" y="1010" width="600" height="330" as="geometry" />
        </mxCell>

        <mxCell id="pe-e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8d6e28;strokeWidth=2;dashed=1;dashPattern=8 4 1 4;endArrow=none;" edge="1" parent="pe-g1" source="pe-pub-storycontent" target="pe-ev-scene-content">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="pe-e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#8d6e28;strokeWidth=2;dashed=1;dashPattern=8 4 1 4;endArrow=none;" edge="1" parent="pe-g1" source="pe-pub-storycontent" target="pe-ev-item-def">
          <mxGeometry relative="1" as="geometry" />
