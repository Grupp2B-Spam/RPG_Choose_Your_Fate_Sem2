  <diagram name="Flow — player makes a choice" id="flow-choice">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fc-title" value="Flow — player makes a choice" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fc-sub" value="The choice is validated where the content lives. Two consumers take the event independently — there is no saga here." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="fc-l1" value="Player client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l2" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l3" value="SceneManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l4" value="RabbitMQ&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;scenemanager.events&lt;br&gt;player-choice.made&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#d79b00;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l5" value="CharacterManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="200" height="820" as="geometry" />
        </mxCell>
        <mxCell id="fc-l6" value="StoryPathManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="1260" y="80" width="200" height="820" as="geometry" />
        </mxCell>

        <mxCell id="fc-a1" value="3. validates against the read model: does this choice exist in this scene?&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;it does not check that the character is standing there — see OPEN-DESIGN-ISSUES 3.1&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6a860;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fc-l3">
          <mxGeometry x="10" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fc-a2" value="7a. applies the effects&lt;br&gt;−10 HP, +1 sword&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;deltas commute, so this consumer scales&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fc-l5">
          <mxGeometry x="10" y="560" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fc-a3" value="7b. appends the beat at its sequence number&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;an ordered log: one consumer instance until ADR-013 is answered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fc-l6">
          <mxGeometry x="10" y="640" width="180" height="80" as="geometry" />
        </mxCell>

        <mxCell id="fc-m1" value="1. POST /characters/{characterId}/choices&lt;br&gt;{ sceneId, choiceId }  ·  Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.073;exitDx=0;exitDy=0;entryX=0;entryY=0.073;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l1" target="fc-l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m2" value="2. forwarded — token verified locally" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.146;exitDx=0;exitDy=0;entryX=0;entryY=0.146;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l2" target="fc-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m3" value="4. publishes { eventId, characterId, sequence,&lt;br&gt;sceneId, sceneVersion, choiceId, beat, effects }" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.366;exitDx=0;exitDy=0;entryX=0;entryY=0.366;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l3" target="fc-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m4" value="5. next scene — returned immediately,&lt;br&gt;without waiting for either consumer" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.49;exitDx=0;exitDy=0;entryX=1;entryY=0.49;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l3" target="fc-l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m5" value="6. one event, two queues — delivered to both" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.61;exitDx=0;exitDy=0;entryX=0;entryY=0.61;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l4" target="fc-l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fc-m6" value="6. charactermanager.player-choice&lt;br&gt;and storypathmanager.player-choice" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.73;exitDx=0;exitDy=0;entryX=0;entryY=0.73;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fc-l4" target="fc-l6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fc-n1" value="&lt;b&gt;Why there is no saga&lt;/b&gt;&lt;br&gt;7a and 7b are independent. The beat landing half a second after the stat change is not an inconsistency anyone can observe, because nothing reads them together before the next choice. A saga would add a coordinator to protect an invariant that does not exist." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="120" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fc-n2" value="&lt;b&gt;What the queue has to guarantee&lt;/b&gt;&lt;br&gt;Delivery is at-least-once, so both consumers deduplicate on eventId. Order matters only for the path, and it is carried in the data: every entry has a per-character sequence number, so entries can arrive in any order and still be read in sequence." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="350" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fc-n3" value="&lt;b&gt;Open — ADR-013&lt;/b&gt;&lt;br&gt;Who assigns the sequence number? If StoryPathManager assigns it on insert, ordering still depends on arrival order and nothing is gained — the number has to be assigned by the publisher. But that means SceneManager would need to know the character's current position, which today lives in StoryPathManager.&lt;br&gt;&lt;br&gt;Until this is settled, StoryPathManager runs as a single consumer instance (ADR-011)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="580" width="320" height="260" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Flow — recap with narration" id="flow-recap">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="fr-title" value="Flow — recap with narration" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1200" height="36" as="geometry" />
        </mxCell>
        <mxCell id="fr-sub" value="The path is fetched over gRPC from a stored checkpoint, so a recap is rebuilt from a snapshot plus what is new — not from the whole history every time." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1200" height="24" as="geometry" />
        </mxCell>

        <mxCell id="fr-l1" value="Player client" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="60" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l2" value="API Gateway" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="300" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l3" value="RecapManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="540" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l4" value="StoryPathManager&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;gRPC :9091&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l5" value="TextToSpeechManager" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#f3edf7;strokeColor=#9673a6;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1020" y="80" width="200" height="980" as="geometry" />
        </mxCell>
        <mxCell id="fr-l6" value="ElevenLabs&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;external · paid per call&lt;/font&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#90a4ae;verticalAlign=top;fontSize=12;fontStyle=1;spacingTop=6;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="1260" y="80" width="200" height="980" as="geometry" />
        </mxCell>

        <mxCell id="fr-a1" value="3. reads its checkpoint for this character&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;the sequence number of the last beat already in the recap&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l3">
          <mxGeometry x="10" y="150" width="180" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fr-a2" value="7. generates the recap with the LLM and stores it&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;the checkpoint advances to snapshotSequence — the snapshot pattern, ADR-013&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l3">
          <mxGeometry x="10" y="480" width="180" height="80" as="geometry" />
        </mxCell>
        <mxCell id="fr-a3" value="9. hash = sha256(text + voice)&lt;br&gt;looks in its own store first" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l5">
          <mxGeometry x="10" y="620" width="180" height="60" as="geometry" />
        </mxCell>
        <mxCell id="fr-a4" value="12. stores the file in MinIO under the hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#9673a6;fontSize=10;align=left;verticalAlign=top;spacingLeft=8;spacingTop=6;" vertex="1" parent="fr-l5">
          <mxGeometry x="10" y="820" width="180" height="50" as="geometry" />
        </mxCell>

        <mxCell id="fr-m1" value="1. GET /characters/{characterId}/recaps/latest?audio=true&lt;br&gt;Bearer JWT" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.061;exitDx=0;exitDy=0;entryX=0;entryY=0.061;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l1" target="fr-l2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m2" value="2. forwarded — token verified locally" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.122;exitDx=0;exitDy=0;entryX=0;entryY=0.122;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l2" target="fr-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m3" value="4. gRPC GetChoicesAfter(characterId,&lt;br&gt;afterSequence, pageSize, snapshotSequence=0)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6c5ce7;exitX=1;exitY=0.265;exitDx=0;exitDy=0;entryX=0;entryY=0.265;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m4" value="5. entries after the checkpoint, strictly ascending,&lt;br&gt;plus snapshotSequence and hasMore" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;fontColor=#6c5ce7;exitX=0;exitY=0.337;exitDx=0;exitDy=0;entryX=1;entryY=0.337;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l4" target="fr-l3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m5" value="6. pages until hasMore is false, echoing snapshotSequence&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;so every page comes from the same high-water mark&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=10;fontColor=#6c5ce7;exitX=1;exitY=0.408;exitDx=0;exitDy=0;entryX=0;entryY=0.408;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m6" value="8. publishes recap-generated&lt;br&gt;&lt;font style=&quot;font-size: 9px&quot;&gt;planned — RecapManager does not publish it yet&lt;/font&gt;" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=10;fontColor=#b07d00;exitX=1;exitY=0.592;exitDx=0;exitDy=0;entryX=0;entryY=0.592;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m7" value="10. on cache miss only" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=1;exitY=0.735;exitDx=0;exitDy=0;entryX=0;entryY=0.735;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l5" target="fr-l6">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m8" value="11. audio file" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.786;exitDx=0;exitDy=0;entryX=1;entryY=0.786;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l6" target="fr-l5">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="fr-m9" value="13. { recapText, audioUrl }" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;exitX=0;exitY=0.918;exitDx=0;exitDy=0;entryX=1;entryY=0.918;entryDx=0;entryDy=0;verticalAlign=bottom;" edge="1" parent="1" source="fr-l3" target="fr-l1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="fr-n1" value="&lt;b&gt;Why gRPC and not REST&lt;/b&gt;&lt;br&gt;RecapManager needs the path to answer a request already in flight, so the call is synchronous. The defensible argument is the enforced contract, not speed: story_path.proto is compiled into both sides, so calling a method that does not exist fails the build rather than the request (ADR-012, ADR-014)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="120" width="320" height="220" as="geometry" />
        </mxCell>
        <mxCell id="fr-n2" value="&lt;b&gt;Cache hit&lt;/b&gt;&lt;br&gt;Steps 10 to 12 are skipped entirely. The answer is immediate and costs nothing at ElevenLabs, because the same text and voice always hash to the same file and the store never overwrites." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="370" width="320" height="170" as="geometry" />
        </mxCell>
        <mxCell id="fr-n3" value="&lt;b&gt;The checkpoint is the snapshot pattern&lt;/b&gt;&lt;br&gt;A recap is rebuilt from a stored checkpoint plus the entries since, rather than by re-reading the whole history. Using snapshotSequence as a high-water mark means a beat appended mid-paging does not land halfway through the recap." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="570" width="320" height="200" as="geometry" />
        </mxCell>
        <mxCell id="fr-n4" value="&lt;b&gt;Dashed lifelines are not built yet&lt;/b&gt;&lt;br&gt;StoryPathManager's gRPC server, the recap-generated event and TextToSpeechManager are all planned. Only steps 1, 2, 3 and 7 run today, against a mock path source." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1520" y="800" width="320" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Development environment — docker compose" id="env-compose">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="dc-title" value="Development environment — docker compose" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="dc-sub" value="The consolidated compose the group is keeping — not yet what main does; see the note on the right. Each service owns a compose file next to its code, and the root file merges them with include:, so everything shares one network and each person edits only their own file." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="dc-project" value="docker compose project — one network" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#f7f9fa;strokeColor=#90a4ae;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#546e7a;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="1240" height="620" as="geometry" />
        </mxCell>

        <mxCell id="dc-root" value="&lt;b&gt;docker-compose.yml&lt;/b&gt; (root)&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;include:&lt;br&gt;· microservices/storycontent-manager/compose.yaml&lt;br&gt;· microservices/recapManager/docker-compose-recap-manager.yml&lt;br&gt;&lt;br&gt;volumes: rabbitmq-data&lt;br&gt;&lt;br&gt;Relative paths inside an included file resolve against that file's own directory, so each service still runs on its own.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-project">
          <mxGeometry x="30" y="50" width="360" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dc-rabbit" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#d79b00;verticalAlign=top;" vertex="1" parent="dc-project">
          <mxGeometry x="420" y="50" width="380" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dc-rabbit-infra" value="&lt;b&gt;RabbitMQ&lt;/b&gt;&lt;br&gt;broker&lt;br&gt;rabbitmq:4-management-alpine&lt;br&gt;container: choose-your-fate-rabbitmq&lt;br&gt;ports: 5672 · 15672&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;One topic exchange per publishing service. Consumers own their queues and bindings.&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="dc-rabbit">
          <mxGeometry x="0" y="0" width="380" height="110" as="geometry" />
        </mxCell>
        <mxCell id="dc-rabbit-compose" value="&lt;font style=&quot;font-size: 10px&quot;&gt;hostname: rabbitmq&lt;br&gt;volume: rabbitmq-data&lt;br&gt;healthcheck: rabbitmq-diagnostics ping&lt;br&gt;restart: unless-stopped&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=4;fontSize=10;strokeColor=none;fillColor=#fffaf2;whiteSpace=wrap;" vertex="1" parent="dc-rabbit">
          <mxGeometry x="0" y="110" width="380" height="80" as="geometry" />
        </mxCell>
        <mxCell id="dc-frontend" value="&lt;b&gt;frontend&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;profiles: [prod]&lt;br&gt;build: ./choose-your-fate-frontend&lt;br&gt;VITE_API_URL: http://localhost:8080/&lt;br&gt;ports: 5173 → 80&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-project">
          <mxGeometry x="830" y="50" width="380" height="190" as="geometry" />
        </mxCell>

        <mxCell id="dc-inc-recap" value="included — microservices/recapManager/" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#e8f5e9;strokeColor=#66a06a;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=2;fontColor=#3f7043;" vertex="1" parent="dc-project">
          <mxGeometry x="30" y="270" width="570" height="310" as="geometry" />
        </mxCell>
        <mxCell id="dc-recap-manager" value="&lt;b&gt;recap-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;profiles: [prod]&lt;br&gt;build: .&lt;br&gt;ports: 8090 → 8090&lt;br&gt;MYSQL_URI: recap-vault:3306&lt;br&gt;STORYPATH_GRPC_TARGET: storypath-manager:9091&lt;br&gt;JWT public key: read-only bind mount&lt;br&gt;depends_on: recap-vault (service_healthy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-recap">
          <mxGeometry x="20" y="50" width="250" height="230" as="geometry" />
        </mxCell>
        <mxCell id="dc-recap-vault" value="&lt;b&gt;recap-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;image: mysql:9.5.0&lt;br&gt;ports: 3307 → 3306&lt;br&gt;volume: recap-vault&lt;br&gt;init: 01_schema_recap_vault.sql&lt;br&gt;healthcheck: mysqladmin ping&lt;br&gt;&lt;br&gt;Seeding runs only on the first start, when the volume is created.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-recap">
          <mxGeometry x="300" y="50" width="250" height="230" as="geometry" />
        </mxCell>

        <mxCell id="dc-inc-storycontent" value="included — microservices/storycontent-manager/" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=4 4;fillColor=#fff8e1;strokeColor=#d6a860;verticalAlign=top;align=left;spacingLeft=12;spacingTop=5;fontSize=11;fontStyle=2;fontColor=#8d6e28;" vertex="1" parent="dc-project">
          <mxGeometry x="630" y="270" width="580" height="310" as="geometry" />
        </mxCell>
        <mxCell id="dc-storycontent-manager" value="&lt;b&gt;storycontent-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;profiles: [prod]&lt;br&gt;build: .&lt;br&gt;ports: 8081 → 8081&lt;br&gt;RABBITMQ_HOST: rabbitmq&lt;br&gt;MYSQL_URI: story-content-vault:3306/story_content&lt;br&gt;depends_on: story-content-vault, rabbitmq&lt;br&gt;(both service_healthy)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-storycontent">
          <mxGeometry x="20" y="50" width="250" height="230" as="geometry" />
        </mxCell>
        <mxCell id="dc-storycontent-vault" value="&lt;b&gt;story-content-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;image: mysql:9.5.0&lt;br&gt;ports: 3309 → 3306&lt;br&gt;MYSQL_DATABASE: story_content&lt;br&gt;volume: story-content-vault&lt;br&gt;init: ./db-init&lt;br&gt;healthcheck: mysqladmin ping&lt;br&gt;&lt;br&gt;3307 and 3308 are taken by the monolith's databases.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="dc-inc-storycontent">
          <mxGeometry x="300" y="50" width="260" height="230" as="geometry" />
        </mxCell>

        <mxCell id="dc-e1" value="depends_on · service_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="dc-inc-recap" source="dc-recap-manager" target="dc-recap-vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dc-e2" value="depends_on · service_healthy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#90a4ae;strokeWidth=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="dc-inc-storycontent" source="dc-storycontent-manager" target="dc-storycontent-vault">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="dc-e3" value="depends_on · publishes to storycontent.events" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#d79b00;strokeWidth=2;dashed=1;endArrow=open;endFill=0;fontSize=9;fontColor=#b07d00;" edge="1" parent="dc-project" source="dc-storycontent-manager" target="dc-rabbit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="dc-n1" value="&lt;b&gt;What a bare `docker compose up` starts&lt;/b&gt;&lt;br&gt;Only rabbitmq and the two databases. The services and the frontend carry profiles: [prod], so they stay down unless you ask for them — which is what you want while running a service from the IDE against the containers." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="60" width="340" height="190" as="geometry" />
        </mxCell>
        <mxCell id="dc-n2" value="&lt;b&gt;What is not here yet&lt;/b&gt;&lt;br&gt;AccountManager, SceneManager, CharacterManager, StoryPathManager and TextToSpeechManager have no compose file, and neither does MinIO. Ollama runs on the host at localhost:11434 rather than in the project, so a recap can be generated without a GPU container in the compose file.&lt;br&gt;&lt;br&gt;The monolith is not started by any compose file either." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="270" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="dc-n3" value="&lt;b&gt;The broker still differs between branches&lt;/b&gt;&lt;br&gt;This tab draws the consolidated compose the group is keeping. The root file on main still runs rabbitmq:3.13-management under the container name bar-scan-rabbitmq, a leftover from another project, includes only recapManager, and calls the recap service backend rather than recap-manager. Until that merges, `docker compose up` on main gives you a different broker from the one the contracts describe." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1360" y="540" width="340" height="240" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Local Kubernetes" id="env-k8s">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="k8-title" value="Local Kubernetes — production-like environment" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="k8-sub" value="Names follow the agreed convention: one string per service, used for the Deployment, the Service, the image and the Maven artifact — because a Kubernetes Service name becomes a DNS name other services resolve." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="k8-banner" value="TARGET STATE — none of this exists yet. There is not a single Kubernetes manifest in the repository; every box below is planned, and the one open choice is marked as open." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;strokeWidth=2;align=center;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#8d6e28;" vertex="1" parent="1">
          <mxGeometry x="60" y="10" width="1540" height="40" as="geometry" />
        </mxCell>

        <mxCell id="k8-cluster" value="kind cluster — namespace default" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#f7f9fa;strokeColor=#90a4ae;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=14;fontStyle=1;fontColor=#546e7a;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="70" width="1540" height="1060" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-ingress" value="&lt;b&gt;Ingress&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;the only way in. REST and GraphQL reach the cluster here; gRPC never leaves it.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#e1d5e7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="50" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-registry" value="&lt;b&gt;Local registry&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;every Deployment pulls its image from here. Recommended over loading images by hand, because the CI/CD pipeline has to push somewhere anyway.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#eceff1;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="440" y="50" width="360" height="110" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-keda" value="&lt;b&gt;KEDA&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;watches queue depth on RabbitMQ and starts a Job per message. This is the serverless requirement.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f3edf7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="840" y="50" width="360" height="110" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-account-manager" value="&lt;b&gt;account-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service (ClusterIP)&lt;br&gt;liveness /actuator/health/liveness&lt;br&gt;readiness /actuator/health/readiness&lt;br&gt;scales on request rate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#78909c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="200" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-storycontent-manager" value="&lt;b&gt;storycontent-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service (ClusterIP)&lt;br&gt;admin-only and low traffic — one replica is enough&lt;br&gt;readiness reflects broker connectivity&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#78909c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="410" y="200" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-scene-manager" value="&lt;b&gt;scene-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service (ClusterIP)&lt;br&gt;query serving — scales on request rate or CPU&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#78909c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="780" y="200" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-character-manager" value="&lt;b&gt;character-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service (ClusterIP)&lt;br&gt;consumer — scales on queue depth&lt;br&gt;handlers commute, so replicas are safe (ADR-011)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#78909c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="1150" y="200" width="330" height="180" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-storypath-manager" value="&lt;b&gt;storypath-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service (ClusterIP :9091 gRPC)&lt;br&gt;&lt;b&gt;replicas: 1&lt;/b&gt; — an ordered log, so competing consumers would produce a false history until ADR-013 is answered&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#78909c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="420" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-recap-manager" value="&lt;b&gt;recap-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service (ClusterIP)&lt;br&gt;calls storypath-manager:9091 over gRPC&lt;br&gt;JWT public key mounted from a Secret&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#78909c;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="410" y="420" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-scene-indexer" value="&lt;b&gt;scene-indexer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment, no Service&lt;br&gt;same image and release as scene-manager, deployed separately so projection restarts without taking queries down (ADR-010)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fdf6e3;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="780" y="420" width="330" height="180" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-texttospeech-manager" value="&lt;b&gt;texttospeech-manager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;&lt;b&gt;KEDA ScaledJob&lt;/b&gt;, not a Deployment&lt;br&gt;scales to zero; one pod per message&lt;br&gt;Quarkus native binary — starts in milliseconds, which is what makes scale-to-zero worth having (ADR-009)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#f3edf7;strokeColor=#9673a6;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="1150" y="420" width="330" height="180" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-rabbitmq" value="&lt;b&gt;rabbitmq&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet + Service&lt;br&gt;rabbitmq.default.svc.cluster.local:5672&lt;br&gt;the host the AsyncAPI contract already names&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#fff2e0;strokeColor=#d79b00;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="640" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-account-vault" value="&lt;b&gt;account-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet · MySQL · PersistentVolumeClaim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="410" y="640" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-story-content-vault" value="&lt;b&gt;story-content-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet · MySQL · PersistentVolumeClaim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="780" y="640" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-scene-read-model" value="&lt;b&gt;scene-read-model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet · MongoDB · PersistentVolumeClaim&lt;br&gt;written by scene-indexer, read by scene-manager — one owner, two deployments&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="1150" y="640" width="330" height="160" as="geometry" />
        </mxCell>

        <mxCell id="k8-n-character-vault" value="&lt;b&gt;character-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet · MySQL · PersistentVolumeClaim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="40" y="840" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-storypath-vault" value="&lt;b&gt;storypath-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet · MySQL · PersistentVolumeClaim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="410" y="840" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-recap-vault" value="&lt;b&gt;recap-vault&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet · MySQL · PersistentVolumeClaim&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="780" y="840" width="330" height="160" as="geometry" />
        </mxCell>
        <mxCell id="k8-n-minio" value="&lt;b&gt;minio&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;StatefulSet · object store · PersistentVolumeClaim&lt;br&gt;audio addressed by content hash&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;fillColor=#ffffff;strokeColor=#90a4ae;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="k8-cluster">
          <mxGeometry x="1150" y="840" width="330" height="160" as="geometry" />
        </mxCell>

        <mxCell id="k8-e1" value="watches queue depth" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-keda" target="k8-n-rabbitmq">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e2" value="starts a Job per message" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#9673a6;strokeWidth=2;dashed=1;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-keda" target="k8-n-texttospeech-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e3" value="gRPC :9091" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#6c5ce7;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;fontColor=#6c5ce7;" edge="1" parent="k8-cluster" source="k8-n-recap-manager" target="k8-n-storypath-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e4" value="REST / GraphQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-ingress" target="k8-n-scene-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="k8-e5" value="REST / GraphQL" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#82b366;strokeWidth=2;endArrow=block;endFill=1;fontSize=9;" edge="1" parent="k8-cluster" source="k8-n-ingress" target="k8-n-character-manager">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="k8-note-probes" value="&lt;b&gt;Liveness and readiness answer different questions&lt;/b&gt;&lt;br&gt;Liveness asks whether the process is alive; a failure restarts the pod. Readiness asks whether it can serve; a failure removes it from the Service without restarting it.&lt;br&gt;&lt;br&gt;A service that cannot reach RabbitMQ is not broken and must not be restarted — but it must not receive traffic either. So readiness reflects broker connectivity and liveness does not." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1660" y="70" width="340" height="250" as="geometry" />
        </mxCell>
        <mxCell id="k8-note-config" value="&lt;b&gt;Configuration through the environment&lt;/b&gt;&lt;br&gt;Every host, port and credential is read from an environment variable with a local default, so the same image runs unchanged in compose and in the cluster and only the configuration differs. A service that hardcodes localhost works on one laptop and nowhere else, and the failure only shows up at assembly.&lt;br&gt;&lt;br&gt;Graceful shutdown is set longer than it takes to handle one message, so a redeploy does not abandon work mid-message." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1660" y="340" width="340" height="270" as="geometry" />
        </mxCell>
        <mxCell id="k8-note-images" value="&lt;b&gt;Open — how images reach the cluster&lt;/b&gt;&lt;br&gt;kind load docker-image is simplest and needs no registry, but it is a manual step that cannot appear in a pipeline. A local registry is one more component to run and is what the CD pipeline will have to push to anyway.&lt;br&gt;&lt;br&gt;Drawn here as a registry, but the group has not decided." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1660" y="630" width="340" height="240" as="geometry" />
        </mxCell>
        <mxCell id="k8-note-autoscale" value="&lt;b&gt;What each thing scales on&lt;/b&gt;&lt;br&gt;Not one metric. Consumers scale on queue depth; query-serving services scale on request rate or CPU. Only the services whose handlers commute may be replicated at all — which is the operational payoff of ADR-011, and why storypath-manager is pinned to one replica." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1660" y="890" width="340" height="220" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Contracts and versions" id="contracts">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="ct-title" value="Contracts and versions" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="ct-sub" value="Generated in full from architecture.json. This is the tab the report's per-service section is written from, and the one to change when a service ships: edit the manifest, run the build, and every tab is correct again." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1400" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ct-stamp-label" value="manifest last updated" style="text;html=1;fontSize=11;fontColor=#90a4ae;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="4" width="160" height="22" as="geometry" />
        </mxCell>
        <mxCell id="ct-stamp" value="2026-11-18" style="text;html=1;fontSize=11;fontColor=#90a4ae;align=left;verticalAlign=middle;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="230" y="4" width="200" height="22" as="geometry" />
        </mxCell>

        <mxCell id="ct-table" value="&lt;table&gt;&lt;tr&gt;&lt;th&gt;Service&lt;/th&gt;&lt;th&gt;Version&lt;/th&gt;&lt;th&gt;Status&lt;/th&gt;&lt;th&gt;Stack&lt;/th&gt;&lt;th&gt;Exposes&lt;/th&gt;&lt;th&gt;Publishes&lt;/th&gt;&lt;th&gt;Consumes&lt;/th&gt;&lt;th&gt;Contracts&lt;/th&gt;&lt;th&gt;ADRs&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;AccountManager&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;planned&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;REST&lt;/td&gt;&lt;td&gt;account-deletion-requested&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;⚠ account-manager.openapi.yaml&lt;br&gt;⚠ account-manager.asyncapi.yaml&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;StoryContentManager&lt;/td&gt;&lt;td&gt;0.0.1-SNAPSHOT&lt;/td&gt;&lt;td&gt;skeleton&lt;/td&gt;&lt;td&gt;Spring Boot 4.0.3 / Java 21&lt;/td&gt;&lt;td&gt;REST&lt;/td&gt;&lt;td&gt;scene-content.updated&lt;br&gt;item-definition.updated&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;⚠ storycontent-manager.openapi.yaml&lt;br&gt;✓ storycontent-manager.asyncapi.yaml&lt;/td&gt;&lt;td&gt;ADR-003, ADR-004, ADR-005, ADR-006, ADR-008&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;SceneManager&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;skeleton&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;REST&lt;/td&gt;&lt;td&gt;player-choice.made&lt;/td&gt;&lt;td&gt;scene-content.updated&lt;/td&gt;&lt;td&gt;⚠ scene-manager.openapi.yaml&lt;br&gt;⚠ scene-manager.asyncapi.yaml&lt;/td&gt;&lt;td&gt;ADR-005, ADR-010, ADR-011&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;CharacterManager&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;skeleton&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;REST&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;item-definition.updated&lt;br&gt;player-choice.made&lt;br&gt;account-deletion-requested&lt;/td&gt;&lt;td&gt;⚠ character-manager.openapi.yaml&lt;/td&gt;&lt;td&gt;ADR-011&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;StoryPathManager&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;planned&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;gRPC&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;player-choice.made&lt;br&gt;account-deletion-requested&lt;/td&gt;&lt;td&gt;✓ story_path.proto&lt;/td&gt;&lt;td&gt;ADR-011, ADR-012, ADR-013, ADR-014&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;RecapManager&lt;/td&gt;&lt;td&gt;0.0.1-SNAPSHOT&lt;/td&gt;&lt;td&gt;implemented&lt;/td&gt;&lt;td&gt;Spring Boot 4.0.3 / Java 21&lt;/td&gt;&lt;td&gt;REST, gRPC→storypath-manager&lt;/td&gt;&lt;td&gt;recap-generated&lt;/td&gt;&lt;td&gt;account-deletion-requested&lt;/td&gt;&lt;td&gt;⚠ recap-manager.openapi.yaml&lt;br&gt;✓ story_path.proto&lt;br&gt;⚠ recap-manager.asyncapi.yaml&lt;/td&gt;&lt;td&gt;ADR-012, ADR-013, ADR-014&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;TextToSpeechManager&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;planned&lt;/td&gt;&lt;td&gt;Quarkus, native binary&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;recap-generated&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;ADR-009, ADR-011&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td&gt;choose-your-fate-backend&lt;/td&gt;&lt;td&gt;0.0.1-SNAPSHOT&lt;/td&gt;&lt;td&gt;legacy&lt;/td&gt;&lt;td&gt;Spring Boot 4.0.3 / Java 21&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;—&lt;/td&gt;&lt;td&gt;ADR-008&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=10;fontSize=11;overflow=fill;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="1900" height="760" as="geometry" />
        </mxCell>

        <mxCell id="ct-key" value="&lt;b&gt;Reading this table&lt;/b&gt;&lt;br&gt;✓ marks a contract file the group believes is written; ⚠ marks one that is still a gap. The verifier compares both against the filesystem and reports a mismatch, so a ✓ that is not really there shows up in CI rather than in the report.&lt;br&gt;&lt;br&gt;A dash means the service has nothing of that kind yet — not that it never will." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="840" width="620" height="160" as="geometry" />
        </mxCell>
        <mxCell id="ct-gaps" value="&lt;b&gt;The honest summary&lt;/b&gt;&lt;br&gt;One AsyncAPI document exists, out of four publishers. No OpenAPI document exists at all. The one .proto that exists sits in the caller's source tree rather than with the service that implements it.&lt;br&gt;&lt;br&gt;That is the state of the contracts, and the diagram says so rather than drawing a system that is further along than it is." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="720" y="840" width="620" height="160" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>

  <diagram name="Rejected alternative — separate indexer" id="alt-indexer">
    <mxGraphModel dx="1040" dy="1504" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="alt-title" value="Rejected alternative — the projection as its own service" style="text;html=1;fontSize=22;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-70" width="1400" height="36" as="geometry" />
        </mxCell>
        <mxCell id="alt-sub" value="Kept so the choice can be compared rather than asserted. The question is not how many services there are; it is who owns the read model." style="text;html=1;fontSize=13;fontColor=#607d8b;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-30" width="1400" height="24" as="geometry" />
        </mxCell>

        <mxCell id="alt-rejected" value="REJECTED — SceneIndexer as a service of its own" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#fdecea;strokeColor=#c0392b;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#962d22;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="60" y="60" width="620" height="520" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-indexer" value="&lt;b&gt;SceneIndexer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;consumes scene-content.updated&lt;br&gt;writes only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="alt-rejected">
          <mxGeometry x="30" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-manager" value="&lt;b&gt;SceneManager&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;serves scenes, validates choices&lt;br&gt;reads only&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=12;" vertex="1" parent="alt-rejected">
          <mxGeometry x="320" y="60" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-store" value="&lt;b&gt;scene read model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;MongoDB&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="alt-rejected">
          <mxGeometry x="175" y="250" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="alt-r-warn" value="⚠ Two services share one datastore. Neither can change the document format without asking the other, so they are one unit of deployment in two repositories — exactly the coupling the decomposition exists to remove." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#c0392b;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#962d22;" vertex="1" parent="alt-rejected">
          <mxGeometry x="30" y="390" width="540" height="100" as="geometry" />
        </mxCell>

        <mxCell id="alt-chosen" value="CHOSEN — one service, two deployments (ADR-010)" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#e8f5e9;strokeColor=#66a06a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=14;spacingTop=6;fontSize=13;fontStyle=1;fontColor=#3f7043;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="740" y="60" width="620" height="520" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-service" value="SceneManager — one service, one schema, one release" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;strokeWidth=2;verticalAlign=top;align=left;spacingLeft=10;spacingTop=6;fontSize=11;fontStyle=1;" vertex="1" parent="alt-chosen">
          <mxGeometry x="30" y="60" width="540" height="200" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-api" value="&lt;b&gt;query serving&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment + Service&lt;br&gt;scales on request rate&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="alt-c-service">
          <mxGeometry x="10" y="50" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-indexer" value="&lt;b&gt;scene-indexer&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;Deployment, no Service&lt;br&gt;same image, restarts without taking queries down&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;" vertex="1" parent="alt-c-service">
          <mxGeometry x="280" y="50" width="250" height="130" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-store" value="&lt;b&gt;scene read model&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;MongoDB — owned by SceneManager&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#90a4ae;align=center;verticalAlign=middle;fontSize=12;" vertex="1" parent="alt-chosen">
          <mxGeometry x="175" y="300" width="250" height="110" as="geometry" />
        </mxCell>
        <mxCell id="alt-c-note" value="One owner. The projector can be scaled and restarted on its own, and the schema still has exactly one service answering for it." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#66a06a;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=11;fontColor=#3f7043;" vertex="1" parent="alt-chosen">
          <mxGeometry x="30" y="430" width="540" height="70" as="geometry" />
        </mxCell>

        <mxCell id="alt-e1" value="writes" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="alt-rejected" source="alt-r-indexer" target="alt-r-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="alt-e2" value="reads" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#c0392b;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="alt-rejected" source="alt-r-manager" target="alt-r-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="alt-e3" value="owns" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#66a06a;strokeWidth=2;endArrow=block;endFill=1;fontSize=10;" edge="1" parent="alt-chosen" source="alt-c-service" target="alt-c-store">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="alt-n1" value="&lt;b&gt;The test that decides it&lt;/b&gt;&lt;br&gt;Can the indexer change the document format without asking SceneManager? If yes, they are two services and must not share a store. If no — and here the answer is no, because the shape of a read model is decided by the queries it answers — then they are one service that happens to run as two processes." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="60" y="620" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="alt-n2" value="&lt;b&gt;Ownership follows the schema&lt;/b&gt;&lt;br&gt;A change always starts as &quot;the API needs this field&quot;. The projector is then updated to comply; it never requests a schema change of its own. Calling the indexer the owner while SceneManager only reads would put two services on one data model." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="420" y="620" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="alt-n3" value="&lt;b&gt;When a separate indexer is right&lt;/b&gt;&lt;br&gt;When the index is shared infrastructure that several services query — a search cluster, say — rather than one service's own read model. Then it has its own consumers, its own reasons to change, and no single service answering for its schema.&lt;br&gt;&lt;br&gt;That is not this." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f7f8;strokeColor=#b0bec5;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="780" y="620" width="320" height="280" as="geometry" />
        </mxCell>
        <mxCell id="alt-n4" value="&lt;b&gt;The principle&lt;/b&gt;&lt;br&gt;The goal is not the largest number of separations, but high cohesion and low coupling. Splitting a thing that changes together buys an extra deployment and pays for it with a shared database — which is the coupling the whole decomposition exists to remove.&lt;br&gt;&lt;br&gt;&lt;i&gt;Two deployments sharing a datastore is acceptable only because they are versioned and released together, and one person owns both.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1140" y="620" width="320" height="280" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
