        <mxCell id="broker" value="&lt;b&gt;RabbitMQ&lt;/b&gt; — rabbitmq:4-management-alpine&lt;br&gt;&lt;font style=&quot;font-size: 10px&quot;&gt;one topic exchange per publishing service; consumers own their queues and bindings (ADR-004)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2e0;strokeColor=#d79b00;strokeWidth=2;verticalAlign=top;align=center;spacingTop=8;fontSize=13;arcSize=4;" vertex="1" parent="1">
          <mxGeometry x="800" y="860" width="640" height="520" as="geometry" />
        </mxCell>
        <mxCell id="ev-scene-content-updated" value="&lt;b&gt;scene-content.updated&lt;/b&gt;&lt;br&gt;storycontent.events&lt;br&gt;1 queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=10;align=center;" vertex="1" parent="broker">
          <mxGeometry x="30" y="60" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev-item-definition-updated" value="&lt;b&gt;item-definition.updated&lt;/b&gt;&lt;br&gt;storycontent.events&lt;br&gt;1 queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=10;align=center;" vertex="1" parent="broker">
          <mxGeometry x="30" y="150" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev-player-choice-made" value="&lt;b&gt;player-choice.made&lt;/b&gt;&lt;br&gt;scenemanager.events&lt;br&gt;2 queues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=10;align=center;" vertex="1" parent="broker">
          <mxGeometry x="30" y="240" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev-recap-generated" value="&lt;b&gt;recap-generated&lt;/b&gt;&lt;br&gt;recap.events&lt;br&gt;1 queue" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=10;align=center;" vertex="1" parent="broker">
          <mxGeometry x="30" y="330" width="580" height="70" as="geometry" />
        </mxCell>
        <mxCell id="ev-account-deletion-requested" value="&lt;b&gt;account-deletion-requested&lt;/b&gt;&lt;br&gt;account.events&lt;br&gt;3 queues" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#d79b00;dashed=1;fontSize=10;align=center;" vertex="1" parent="broker">
          <mxGeometry x="30" y="420" width="580" height="70" as="geometry" />
        </mxCell>

        <mxCell id="panel-choose-your-fate-backend" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#eceff1;strokeColor=#78909c;strokeWidth=2;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="800" y="1500" width="640" height="300" as="geometry" />
        </mxCell>
        <mxCell id="card-choose-your-fate-backend" value="&lt;b&gt;choose-your-fate-backend&lt;/b&gt;&lt;br&gt;The monolith. Seventeen controllers covering accounts, auth, content, characters, paths and AI. It is the only part of the system that runs today, and the source the services are being lifted from.&lt;br&gt;monolith — being decomposed" style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=10;fontSize=12;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="panel-choose-your-fate-backend">
          <mxGeometry x="0" y="0" width="640" height="140" as="geometry" />
        </mxCell>
        <mxCell id="note-legacy" value="The only part of the system that runs today. The seven services are being lifted out of it (ADR-008); the pale arrows say which bounded context each part becomes. No compose file starts it, and no decommissioning date has been set." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=6;fontSize=10;fontColor=#546e7a;strokeColor=none;fillColor=#f5f7f8;whiteSpace=wrap;" vertex="1" parent="panel-choose-your-fate-backend">
          <mxGeometry x="0" y="150" width="640" height="150" as="geometry" />
        </mxCell>

        <mxCell id="legend" value="Legend" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b0bec5;verticalAlign=top;align=left;spacingLeft=12;spacingTop=8;fontSize=13;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="1660" width="460" height="320" as="geometry" />
        </mxCell>
        <mxCell id="lg-async" value="— — —  asynchronous event (publish / consume)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#d79b00;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="40" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-grpc" value="————  internal gRPC call (never reaches the browser)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#6c5ce7;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="72" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-rest" value="————  external REST / GraphQL (client-facing)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#82b366;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="104" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-store" value="————  datastore ownership (not communication)" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=12;fontSize=11;fontColor=#90a4ae;strokeColor=none;fillColor=none;" vertex="1" parent="legend">
          <mxGeometry x="10" y="136" width="440" height="30" as="geometry" />
        </mxCell>
        <mxCell id="lg-status" value="● implemented   ◐ skeleton   ○ planned (dashed border)&lt;br&gt;A dashed box is a service that does not exist yet. A branch name under the badge means the code is written but not merged." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;fontColor=#546e7a;strokeColor=none;fillColor=#f5f7f8;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="10" y="172" width="440" height="60" as="geometry" />
        </mxCell>
        <mxCell id="lg-frame" value="Dashed frame = bounded context. Database symbol = a datastore owned by exactly one service. An event box inside RabbitMQ names its exchange and how many queues bind to it." style="text;html=1;align=left;verticalAlign=top;spacingLeft=12;spacingTop=4;fontSize=11;fontColor=#546e7a;strokeColor=none;fillColor=none;whiteSpace=wrap;" vertex="1" parent="legend">
          <mxGeometry x="10" y="236" width="440" height="74" as="geometry" />
        </mxCell>

        <mxCell id="note-oauth" value="&lt;b&gt;Open — OAuth / OIDC&lt;/b&gt;&lt;br&gt;No third-party identity provider has been chosen. Required in addition to our own JWT, and it belongs in AccountManager." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="440" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-graphql" value="&lt;b&gt;Open — GraphQL owner&lt;/b&gt;&lt;br&gt;At least one service must expose GraphQL. SceneManager and CharacterManager are the candidates: both answer queries where a client wants many related fields in one round trip." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="620" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-adr013" value="&lt;b&gt;Open — ADR-013&lt;/b&gt;&lt;br&gt;Who assigns the per-character sequence number? If StoryPathManager assigns it on insert, ordering still depends on arrival order and nothing is gained — and until it is answered, StoryPathManager cannot be scaled horizontally (ADR-011)." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="800" width="340" height="170" as="geometry" />
        </mxCell>
        <mxCell id="note-proto" value="&lt;b&gt;Open — ADR-012&lt;/b&gt;&lt;br&gt;story_path.proto describes StoryPathManager's API but lives in RecapManager's source tree, so the server's owner can have their interface changed without touching their own code." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1000" width="340" height="150" as="geometry" />
        </mxCell>
        <mxCell id="note-ports" value="&lt;b&gt;Open — port allocation&lt;/b&gt;&lt;br&gt;8081 and 8090 are taken, and 8092 is implied by RecapManager's JWT_ISSUER default without anyone having written it down. Services with no agreed port show none here rather than an invented one." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1180" width="340" height="160" as="geometry" />
        </mxCell>
        <mxCell id="note-keda" value="&lt;b&gt;Open — serverless&lt;/b&gt;&lt;br&gt;TextToSpeechManager is meant to run as a KEDA ScaledJob scaled on queue depth, which is why it is on Quarkus (ADR-009). Neither the job nor the cold-start measurement exists yet." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff8e1;strokeColor=#d6a860;align=left;verticalAlign=top;spacingLeft=10;spacingTop=8;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="2220" y="1460" width="340" height="160" as="geometry" />
        </mxCell>

