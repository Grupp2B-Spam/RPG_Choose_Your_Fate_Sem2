# Production runtime environment contract. Supply values from repository secrets at deployment.
# For local development use local.env.example instead; these are not image build arguments.
# Environment-file values must be plain values (no shell interpolation or inline comments).
MYSQL_URI=
MYSQL_USERNAME=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=tts-audio
MINIO_REGION=us-east-1
RABBITMQ_HOST=
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=
KEYCLOAK_ISSUER_URI=
KEYCLOAK_AUDIENCE=
KEYCLOAK_JWK_SET_URI=
KEYCLOAK_ROLE_CLIENT_ID=
TTS_EVENT_JWT_ISSUER=
TTS_EVENT_JWT_AUDIENCE=
TTS_EVENT_JWT_JWKS_URI=
TTS_EVENT_JWT_SUBJECTS=
# Production uses elevenlabs. The local profile supplies its own mock defaults.
ELEVEN_LABS_API_KEY=
TTS_PROVIDER_MODE=elevenlabs
TTS_MOCK_AUDIO_FILE=
# Owned by TextToSpeechManager only; callers do not send these settings.
SPEECH_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
SPEECH_MODEL=eleven_turbo_v2_5
SPEECH_OUTPUT_FORMAT=mp3_44100_128
