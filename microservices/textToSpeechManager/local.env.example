# Optional local overrides. Copy to .env in this service directory; never commit real values.
# These names are used by both the service's Compose file and its local Spring profile.
TTS_MYSQL_USERNAME=tts_local
TTS_MYSQL_PASSWORD=tts-local-development
TTS_MYSQL_ROOT_PASSWORD=tts-root-local-development
TTS_LOCAL_MINIO_PASSWORD=minio-local-development-only
# Match the shared broker credentials configured in the root Compose .env, if changed.
RABBITMQ_USERNAME=rabbitmq
RABBITMQ_PASSWORD=rabbitmq
# For standalone speech Compose connecting to the root broker through its published host port:
# TTS_RABBITMQ_HOST=host.docker.internal
# Optional public-key file; relative paths resolve from the speech service directory.
# TTS_JWT_PUBLIC_KEY_FILE=../recapManager/.local/recap-jwt-public.pem
# Browser-reachable MinIO URL, used in signed audio links:
MINIO_PUBLIC_ENDPOINT=http://localhost:9002
