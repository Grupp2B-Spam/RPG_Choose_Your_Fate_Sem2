            <mxPoint x="1025" y="615" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a3" value="10. stores it in MinIO under the hash" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="935" y="645" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="m11" value="11. { audioUrl }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=11;endSize=8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1025" y="730" as="sourcePoint" />
            <mxPoint x="585" y="730" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m12" value="12. { recapText, audioUrl }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=11;endSize=8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="785" as="sourcePoint" />
            <mxPoint x="365" y="785" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m13" value="13. { recapText, audioUrl }" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=11;endSize=8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="365" y="840" as="sourcePoint" />
            <mxPoint x="145" y="840" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="fn1" value="&lt;b&gt;Cache hit&lt;/b&gt;&lt;br&gt;&lt;br&gt;Steps 8–10 are skipped entirely. The answer is immediate and costs nothing at 11labs." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="465" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="fn2" value="&lt;b&gt;Idempotency&lt;/b&gt;&lt;br&gt;&lt;br&gt;The call can be repeated freely — the same text yields the same hash, and no new file is made.&lt;br&gt;&lt;br&gt;That is what makes an event-driven variant (at-least-once) safe to build on later." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="600" width="240" height="170" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
