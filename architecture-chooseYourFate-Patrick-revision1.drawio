        <mxCell id="m4" value="4. sequence of beats — self-contained, no lookups into content" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=11;endSize=8;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="805" y="315" as="sourcePoint" />
            <mxPoint x="585" y="315" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a1" value="5. generates the recap with an LLM&lt;br&gt;and stores it in the Recap vault" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="495" y="345" width="180" height="46" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="6. POST /speech { text, voice }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="435" as="sourcePoint" />
            <mxPoint x="1025" y="435" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="a2" value="7. hash = sha256(text + voice)&lt;br&gt;looks it up in its own cache" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="930" y="465" width="190" height="46" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="8. only on a cache miss" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="1025" y="560" as="sourcePoint" />
            <mxPoint x="1245" y="560" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m9" value="9. audio file" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=11;endSize=8;strokeColor=#b85450;fontColor=#b85450;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
