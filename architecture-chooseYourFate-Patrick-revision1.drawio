          <mxGeometry relative="1" as="geometry">
            <mxPoint x="365" y="205" as="sourcePoint" />
            <mxPoint x="585" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="m3" value="3. GET /storypaths/{characterId}" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
