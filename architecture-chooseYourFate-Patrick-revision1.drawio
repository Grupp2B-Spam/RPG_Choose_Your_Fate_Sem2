        <mxCell id="L6" value="11labs" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="40" width="170" height="840" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="1. GET /characters/{characterId}/recaps/latest?audio=true  (Bearer JWT)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
