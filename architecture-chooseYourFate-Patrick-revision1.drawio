        <mxCell id="e28" edge="1" parent="1" source="q4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;verticalAlign=top;" target="s5" value="Consumer — applies the effects">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1290" y="1027" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e30" edge="1" parent="1" source="s2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=11;" target="q1" value="Publisher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e31" edge="1" parent="1" source="q1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=0;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;fontSize=11;" target="s5" value="Consumer — raises the character limit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e23" edge="1" parent="1" source="s7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0.75;entryY=0;entryDx=0;entryDy=0;fontSize=11;" target="s6" value="GET /storypaths/{characterId}">
          <mxGeometry relative="1" x="0.5239" y="105" as="geometry">
            <mxPoint as="offset" />
            <Array as="points">
              <mxPoint x="1335" y="469" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e32" edge="1" parent="1" source="s7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;" target="q5" value="Publisher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e33" edge="1" parent="1" source="q5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;fontSize=11;" target="s8" value="Consumer — generates the audio&lt;br&gt;before anyone asks for it">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e24" edge="1" parent="1" source="s7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;align=right;" target="s8" value="POST /speech&lt;br&gt;&lt;font style=&quot;font-size: 10px;&quot;&gt;a lookup, not work&lt;/font&gt;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1646" y="506" />
              <mxPoint x="1646" y="727" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e26" edge="1" parent="1" source="s4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=0.56;exitY=1;exitDx=0;exitDy=0;entryX=0.94;entryY=1;entryDx=0;entryDy=0;dashed=1;strokeColor=#9673a6;fontColor=#9673a6;fontSize=11;" target="s8" value="POST /speech (planned)">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="371" y="1650" />
              <mxPoint x="1789" y="1650" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e25" edge="1" parent="1" source="s8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;fontSize=11;verticalAlign=bottom;" target="ext1" value="HTTP">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="n1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" value="&lt;b&gt;JWT&lt;/b&gt;&lt;br&gt;&lt;br&gt;AccountManager signs with a private key (RS256). Every service verifies locally with the public key — no network call per request, and a compromised service cannot forge tokens." vertex="1">
          <mxGeometry height="160" width="250" x="100" y="120" as="geometry" />
        </mxCell>
        <mxCell id="n5" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#dae8fc;strokeColor=#6c8ebf;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" value="&lt;b&gt;characterId, not playerId&lt;/b&gt;&lt;br&gt;&lt;br&gt;A player can have several characters, and each character has its own playthrough.&lt;br&gt;&lt;br&gt;Path, recap and choice events are therefore keyed on characterId. With playerId, RecapManager would blend two stories together." vertex="1">
          <mxGeometry height="195" width="250" x="80" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="n4" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e8f5e9;strokeColor=#66a06a;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" value="&lt;b&gt;Log vs. state&lt;/b&gt;&lt;br&gt;&lt;br&gt;StoryPathManager holds the history: immutable, append-only.&lt;br&gt;&lt;br&gt;CharacterManager holds the present: stats, HP, inventory, equipment. Everything an equip or a potion touches lives in the same place — one transaction, no saga." vertex="1">
          <mxGeometry height="200" width="250" x="1650" y="1010" as="geometry" />
        </mxCell>
        <mxCell id="n3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#e0f2f1;strokeColor=#4db6ac;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" value="&lt;b&gt;The purchase does not gate content&lt;/b&gt;&lt;br&gt;&lt;br&gt;The only thing for sale is more character slots. SceneManager is therefore untouched: no entitlement checks, no claims in the JWT, no projection.&lt;br&gt;&lt;br&gt;The rule is enforced by CharacterManager when a character is created." vertex="1">
          <mxGeometry height="200" width="250" x="1650" y="1300" as="geometry" />
        </mxCell>
        <mxCell id="n0" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f3edf7;strokeColor=#9673a6;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" value="&lt;b&gt;Two ways into TTS&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;The event&lt;/b&gt; does the work: TTS listens for RecapGenerated and makes the audio before anyone asks. Nobody waits on 11labs.&lt;br&gt;&lt;br&gt;&lt;b&gt;POST /speech&lt;/b&gt; is then only a lookup — the hash already exists, and the answer is immediate.&lt;br&gt;&lt;br&gt;Any service may use either path. TTS does not know who is asking, and knows no domains." vertex="1">
          <mxGeometry height="280" width="250" x="2160" y="360" as="geometry" />
        </mxCell>
        <mxCell id="n2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#FFF9C4;strokeColor=#d6b656;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" value="&lt;b&gt;Content hash&lt;/b&gt;&lt;br&gt;&lt;br&gt;TTS keys files on sha256(text + voice). Same text → same file.&lt;br&gt;&lt;br&gt;It never overwrites: idempotent under repeated events, free deduplication and free rollback. Cleanup is a TTL sweep, not delete events." vertex="1">
          <mxGeometry height="200" width="250" x="2160" y="670" as="geometry" />
        </mxCell>
        <mxCell id="lg" parent="1" style="swimlane;whiteSpace=wrap;html=1;startSize=26;fontSize=12;fillColor=none;strokeColor=#999999;" value="Legend" vertex="1">
          <mxGeometry height="255" width="350" x="560" y="1250" as="geometry" />
        </mxCell>
        <mxCell id="lg1" parent="lg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;" value="Microservice" vertex="1">
          <mxGeometry height="36" width="145" x="20" y="40" as="geometry" />
        </mxCell>
        <mxCell id="lg2" parent="lg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;" value="External service" vertex="1">
          <mxGeometry height="36" width="145" x="185" y="40" as="geometry" />
        </mxCell>
        <mxCell id="lg3" parent="lg" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;" value="Client" vertex="1">
          <mxGeometry height="36" width="145" x="20" y="88" as="geometry" />
        </mxCell>
        <mxCell id="lg4" parent="lg" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#999999;fontSize=11;" value="Queue" vertex="1">
          <mxGeometry height="36" width="145" x="185" y="88" as="geometry" />
        </mxCell>
        <mxCell id="lg5" parent="lg" style="rounded=1;whiteSpace=wrap;html=1;dashed=1;dashPattern=8 8;fillColor=#fff8e1;strokeColor=#d6a860;strokeWidth=2;fontSize=11;arcSize=10;" value="Dashed frame = bounded context" vertex="1">
          <mxGeometry height="36" width="310" x="20" y="136" as="geometry" />
        </mxCell>
        <mxCell id="lg6" parent="lg" style="text;html=1;align=left;verticalAlign=top;fontSize=11;spacingLeft=2;" value="Database symbol = datastore, owned by exactly one service&lt;br&gt;Topic = publish/subscribe; each consumer has its own subscription&lt;br&gt;Dashed purple arrow = planned, not built yet" vertex="1">
          <mxGeometry height="60" width="310" x="20" y="184" as="geometry" />
        </mxCell>
        <mxCell id="q6" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;align=center;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" value="Queue" vertex="1">
          <mxGeometry height="56" width="195" x="270" y="857" as="geometry" />
        </mxCell>
        <mxCell id="q6c" parent="q6" style="text;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="ItemDefinition.updated" vertex="1">
          <mxGeometry height="30" width="195" y="26" as="geometry" />
        </mxCell>
        <mxCell id="e19b" edge="1" parent="1" source="s3" style="rounded=0;html=1;fontSize=11;exitX=0.9;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;edgeStyle=orthogonalEdgeStyle;" target="q6" value="Publisher">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e35" edge="1" parent="1" source="q6" style="rounded=0;html=1;fontSize=11;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;verticalAlign=bottom;edgeStyle=orthogonalEdgeStyle;" target="s5" value="Consumer — projection of item rules">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="730" y="885.08" />
              <mxPoint x="730" y="1126.31" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="Mg9m2DKrj7nk9-Lv1GwX-1" parent="1" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=0;marginBottom=0;align=center;fontSize=12;fillColor=#ffffff;strokeColor=#999999;" value="Topic" vertex="1">
          <mxGeometry height="56" width="180" x="1440" y="540" as="geometry" />
        </mxCell>
        <mxCell id="Mg9m2DKrj7nk9-Lv1GwX-2" parent="Mg9m2DKrj7nk9-Lv1GwX-1" style="text;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;fontSize=11;whiteSpace=wrap;html=1;fillColor=#ffffff;" value="RecapGenerated" vertex="1">
          <mxGeometry height="30" width="180" y="26" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Flow - player makes a choice" id="arch-flow-choice">
    <mxGraphModel dx="2000" dy="1400" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="ctitle" value="Flow — the player makes a choice" style="text;html=1;fontSize=24;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-50" width="900" height="36" as="geometry" />
        </mxCell>
        <mxCell id="csub" value="The choice is validated where the content lives. Two consumers take the event independently — no saga." style="text;html=1;fontSize=13;fontColor=#666666;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="-12" width="900" height="24" as="geometry" />
        </mxCell>
        <mxCell id="K1" value="Player client" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="60" y="40" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="K2" value="API Gateway" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#e1d5e7;strokeColor=#9673a6;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="280" y="40" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="K3" value="SceneManager" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="500" y="40" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="K4" value="Topic&lt;br&gt;PlayerChoice.made" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#f5f5f5;strokeColor=#999999;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="720" y="40" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="K5" value="CharacterManager" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="940" y="40" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="K6" value="StoryPathManager" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=0;collapsible=0;recursiveResize=0;outlineConnect=0;size=50;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=12;" vertex="1" parent="1">
          <mxGeometry x="1160" y="40" width="170" height="700" as="geometry" />
        </mxCell>
        <mxCell id="k1" value="1. POST /characters/{characterId}/choices  { sceneId, choiceId }  (Bearer JWT)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="145" y="150" as="sourcePoint" />
            <mxPoint x="365" y="150" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k2" value="2. forwarded — token verified" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="365" y="205" as="sourcePoint" />
            <mxPoint x="585" y="205" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ka1" value="3. validates against the read model:&lt;br&gt;does the choice exist in the scene?" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="495" y="235" width="180" height="46" as="geometry" />
        </mxCell>
        <mxCell id="k4" value="4. publishes { eventId, characterId, sceneId, sceneVersion, choiceId, beat, effects }" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="330" as="sourcePoint" />
            <mxPoint x="805" y="330" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k5" value="5. next scene — immediately" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=11;endSize=8;strokeColor=#82b366;fontColor=#4d7a3a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="585" y="395" as="sourcePoint" />
            <mxPoint x="365" y="395" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k6" value="6." style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;rounded=0;fontSize=11;endSize=8;strokeColor=#82b366;fontColor=#4d7a3a;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="365" y="445" as="sourcePoint" />
            <mxPoint x="145" y="445" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="k7" value="7a. Consumer" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="805" y="520" as="sourcePoint" />
            <mxPoint x="1025" y="520" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ka2" value="−10 HP, +1 sword&lt;br&gt;one transaction" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="945" y="545" width="160" height="42" as="geometry" />
        </mxCell>
        <mxCell id="k8" value="7b. Consumer" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;fontSize=11;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="805" y="630" as="sourcePoint" />
            <mxPoint x="1245" y="630" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="ka3" value="appends the beat to the character&#39;s history" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#6c8ebf;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1165" y="655" width="160" height="42" as="geometry" />
        </mxCell>
        <mxCell id="kn1" value="&lt;b&gt;Why there is no saga&lt;/b&gt;&lt;br&gt;&lt;br&gt;7a and 7b are independent. The beat landing half a second after the stat change does no harm.&lt;br&gt;&lt;br&gt;Only HP and inventory have to be atomic — and they live in the same place." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#d5e8d4;strokeColor=#82b366;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="150" width="250" height="180" as="geometry" />
        </mxCell>
        <mxCell id="kn2" value="&lt;b&gt;Two requirements on the queue&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;b&gt;Ordering:&lt;/b&gt; a path is a sequence. The queue is partitioned on characterId, so one character&#39;s choices always arrive in order.&lt;br&gt;&lt;br&gt;&lt;b&gt;Duplicates:&lt;/b&gt; at-least-once means the same event can arrive twice. Both consumers deduplicate on eventId — the same principle as the content hash in TTS." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8cecc;strokeColor=#b85450;align=left;verticalAlign=top;spacing=8;size=16;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="1400" y="360" width="250" height="255" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
